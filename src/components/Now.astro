---
import SectionHeading from './SectionHeading.astro';

// Edit these bullets quarterly. Each bullet is a snapshot of current focus.
const items = [
  {
    label: 'Working on',
    text: 'Shipping features for <a href="https://www.innogames.com/games/forge-of-empires/" class="underline decoration-border hover:decoration-fg-muted" target="_blank" rel="noopener noreferrer">Forge of Empires</a> at InnoGames.',
  },
  {
    label: 'Building',
    text: '<a href="https://github.com/andreiRS/tasks" class="underline decoration-border hover:decoration-fg-muted" target="_blank" rel="noopener noreferrer">Tasks</a>, a git-backed CLI where humans and Claude Code agents drive the same task board. Plus a steady drip of small AI experiments on the side.',
  },
  {
    label: 'Learning',
    text: 'LLM orchestration and dynamic workflows, getting agents to coordinate real multi-step work.',
  },
];

const lastUpdated = '2026-05';
---

<section class="py-10">
  <SectionHeading
    id="now"
    title="Now"
    subtitle={`What I'm focused on, as of ${lastUpdated}.`}
  />
  <ul class="space-y-3">
    {
      items.map((item) => (
        <li class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
          <span class="text-sm uppercase tracking-wide text-fg-faint sm:w-28 shrink-0">
            {item.label}
          </span>
          <span class="text-fg" set:html={item.text} />
        </li>
      ))
    }
  </ul>
  <p class="mt-4 text-sm text-fg-faint">
    Inspired by <a href="https://nownownow.com/about" class="underline hover:text-fg-muted">the /now page movement</a>.
  </p>
</section>
