---
interface Link {
  label: string;
  url: string;
}

interface Props {
  title: string;
  year?: number;
  kind: 'innogames' | 'side' | 'experiment';
  status: 'live' | 'archived' | 'building' | 'experiment' | 'tbd';
  description: string;
  links?: Link[];
}

const { title, year, kind, status, description, links = [] } = Astro.props;

const kindLabel = {
  innogames: 'InnoGames',
  side: 'side',
  experiment: 'experiment',
}[kind];

const statusColor = {
  live: 'text-success',
  building: 'text-highlight',
  archived: 'text-fg-faint',
  experiment: 'text-info',
  tbd: 'text-fg-faint',
}[status];

const statusDot = {
  live: 'bg-success',
  building: 'bg-highlight',
  archived: 'bg-fg-faint',
  experiment: 'bg-info',
  tbd: 'bg-fg-faint',
}[status];

const primaryLink = links[0];
---

<article class="rounded-lg border border-border bg-bg/40 p-4 flex flex-col gap-2">
  <div class="flex items-baseline justify-between gap-3">
    <h3 class="text-base font-medium text-fg truncate">{title}</h3>
    {year && <span class="text-xs font-mono text-fg-faint shrink-0">'{year.toString().slice(-2)}</span>}
  </div>
  <p class="text-sm text-fg-dim line-clamp-2">{description}</p>
  <div class="mt-auto flex items-center gap-3 text-xs text-fg-faint">
    <span class="rounded bg-surface/80 px-1.5 py-0.5 text-fg-muted">{kindLabel}</span>
    <span class="flex items-center gap-1.5">
      <span class={`inline-block h-1.5 w-1.5 rounded-full ${statusDot}`}></span>
      <span class={statusColor}>{status}</span>
    </span>
    {
      primaryLink && (
        <a
          href={primaryLink.url}
          class="ml-auto text-info hover:opacity-80"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={primaryLink.label}
        >
          ↗
        </a>
      )
    }
  </div>
</article>
